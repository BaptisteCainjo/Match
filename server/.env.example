# Port de l'application (Railway l'assigne automatiquement)
PORT=5000

# URL de la base de données (sera fournie par Railway si tu ajoutes une DB)
# DATABASE_URL=postgresql://user:password@host:port/database

# Autres variables que tu pourrais avoir besoin
# JWT_SECRET=your-jwt-secret-here
# API_KEY=your-api-key-here